# The Windows client's config: the plugin is downloaded from a url.
# `leaf-plugin-verify render` fills in the placeholder with url, sha256 and size.

[General]
loglevel = info
socks-interface = 127.0.0.1
socks-port = 1080

[Plugin]
ss = {{ss}}

[Proxy]
SS = plugin, 127.0.0.1, 8388, plugin=ss, args=aes-128-gcm;verify-password

[Rule]
FINAL, SS
