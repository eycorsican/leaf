# The mobile client's config: the builtin if the client has it, the url if not.
# The same file serves both kinds of client.

[General]
loglevel = info
socks-interface = 127.0.0.1
socks-port = 1080

[Plugin]
ss = builtin=shadowsocks-rs, {{ss}}

[Proxy]
SS = plugin, 127.0.0.1, 8388, plugin=ss, args=aes-128-gcm;verify-password

[Rule]
FINAL, SS
