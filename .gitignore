# TRAE
.trae/

# Generated by Cargo
# will have compiled files and executables
/target/

# Local working notes and references, never part of the repository
/.scratch/

# Generated plugin artifacts
/leaf-plugins/tls-cabi-go/*.dll
/leaf-plugins/tls-cabi-go/*.dylib
/leaf-plugins/tls-cabi-go/*_cabi_go.h
/leaf-plugins/trojan-cabi-go/*.dll
/leaf-plugins/trojan-cabi-go/*.dylib
/leaf-plugins/trojan-cabi-go/*_cabi_go.h
/leaf-plugins/socks5-cabi-c/*.dll
/leaf-plugins/socks5-cabi-c/*.dylib
/leaf-plugins/socks5-cabi-c/*.so
/leaf-plugins/socks5-cabi-c/socks5_test
/leaf-plugins/socks5-cabi-zig/zig-out/
/leaf-plugins/socks5-cabi-zig/.zig-cache/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk
# Swap
[._]*.s[a-v][a-z]
!*.svg  # comment out if you don't need vector files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
